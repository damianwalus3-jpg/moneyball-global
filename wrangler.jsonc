{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moneyball-global-rebuild",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/api/pitchapi/*", "/api/flashscore/*", "/api/footynomad/*", "/api/openligadb/*", "/api/espn/*", "/api/odds/*"]
  },
  "observability": { "enabled": true }
}
